# --- Database (Supabase Postgres) ---
# Containers use the Supavisor pooler (6543); migrations use the direct connection (5432).
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:6543/postgres?sslmode=require
DATABASE_URL_DIRECT=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres?sslmode=require

# --- Queue (Upstash Redis, TLS mandatory) ---
REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379

# --- Object Storage (Supabase Storage, S3-compatible) ---
OBJECT_STORAGE_ENDPOINT=https://<project>.storage.supabase.co/storage/v1/s3
OBJECT_STORAGE_REGION=eu-west-1
OBJECT_STORAGE_BUCKET=<bucket>
OBJECT_STORAGE_ACCESS_KEY=<access-key>
OBJECT_STORAGE_SECRET_KEY=<secret-key>

# --- PayPal (sandbox) ---
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- AI (rig; any provider) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Zapier MCP (bank petition + alerts) ---
ZAPIER_MCP_URL=

# --- KERNEL (DGFT portal browser agent) ---
KERNEL_API_KEY=

# --- DGFT (mock server in demo) ---
DGFT_BASE_URL=http://localhost:4010
DGFT_API_KEY=demo
DGFT_CLIENT_ID=demo
DGFT_CLIENT_SECRET=demo

# --- Server ---
BIND_ADDR=0.0.0.0:8080
PUBLIC_BASE_URL=http://localhost:8080
